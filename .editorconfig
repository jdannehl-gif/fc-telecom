root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,bicep,bicepparam}]
indent_size = 2

[*.{razor,cshtml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Modern C# style
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion

# Correctness rules we care enough about to fail the build on
dotnet_diagnostic.CA2007.severity = none          # No SynchronizationContext in ASP.NET Core
dotnet_diagnostic.CA1848.severity = none          # LoggerMessage source-gen: not worth it everywhere
dotnet_diagnostic.CA1062.severity = none          # Nullable reference types cover this
dotnet_diagnostic.CA2100.severity = error         # SQL injection review
dotnet_diagnostic.CA5350.severity = error         # Weak crypto
dotnet_diagnostic.CA5351.severity = error         # Broken crypto
dotnet_diagnostic.CA3001.severity = error         # SQL injection
dotnet_diagnostic.CA3003.severity = error         # File path injection
dotnet_diagnostic.CA3075.severity = error         # Insecure DTD processing
dotnet_diagnostic.IDE0055.severity = suggestion   # Formatting: advisory, not a build break

# IDE0005 (unnecessary using directive) only reports during build when
# GenerateDocumentationFile is true, which it is not here. Pinned to suggestion so the
# behaviour is explicit rather than an accident of that setting — otherwise turning doc
# files on later would silently start failing the build on warnings-as-errors.
dotnet_diagnostic.IDE0005.severity = suggestion

# Naming
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# ── Test projects ───────────────────────────────────────────────────────────────────────
#
# Scoped to tests/ deliberately. These two rules are correct for library code and wrong for
# test code, and the distinction is the file's location, not a judgement about the rule.
[tests/**.cs]

# CA1707 — no underscores in member names.
#
# The rule exists to keep PUBLIC API names conventional. A test method is not public API:
# nobody calls it, and its name is the failure message. `UnknownTime_IsExcludedFromThe
# Denominator_NotCountedAsUp` tells whoever is reading a red CI run what broke;
# `UnknownTimeIsExcludedFromTheDenominatorNotCountedAsUp` does not.
#
# Method_Scenario_Expectation is the near-universal .NET convention, and roughly 80 test
# names here follow it. Renaming them to satisfy a public-API rule would trade real
# diagnostic value for nothing.
dotnet_diagnostic.CA1707.severity = none

# CA1861 — prefer static readonly fields over constant array arguments.
#
# A real allocation concern on a hot path. In a test, the inline `[180, 120, 90, 60, 30]`
# next to the assertion is the point: hoisting it to a field at the top of the class moves
# the data away from the case that depends on it, and the allocation happens once per test.
dotnet_diagnostic.CA1861.severity = none
